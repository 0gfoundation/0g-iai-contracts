# Deployer key (0G side). Never commit the real .env.
PRIVATE_KEY=0x

# Mnemonic used to derive the 1000 testnet accounts (Accounts.s.sol).
# Regenerating from the same mnemonic reproduces the same address set.
# REPLACE THIS. The value below is the well-known Anvil default -- anything funded on it
# is drainable by anyone. Generate a fresh one and keep it out of version control.
TEST_MNEMONIC="test test test test test test test test test test test junk"

# Optional: redirect the deployments/ directory (used by CI / ephemeral runs).
# DEPLOYMENT_PATH=

# Block explorer verification (0G ignores the key value, but the flag is required).
VERIFIER_KEY=00
