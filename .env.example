# Deployer key (0G side). Never commit the real .env.
PRIVATE_KEY=0x

# Mnemonic used to derive the testnet accounts (Accounts.s.sol). The same mnemonic always
# reproduces the same address set.
#
# REPLACE THIS. The value below is the well-known Anvil default -- anything funded on it is
# drainable by anyone. It is also the phrase whose account 0 is the usual local deployer, and
# Accounts.s.sol refuses to enumerate the deployer's own key, so leaving it here will simply
# stop the script rather than quietly publish that key.
TEST_MNEMONIC="test test test test test test test test test test test junk"

# Optional overrides for Accounts.s.sol. The defaults are 50 accounts, 10 0G of gas each and
# 100,000 mock a0G each -- so the deployer needs 500 0G on hand for the gas. a0G is generous
# because the mock's mint is an open faucet; topping up costs nothing.
# ACCOUNT_COUNT=50
# ACCOUNT_GAS=10000000000000000000
# ACCOUNT_A0G=100000000000000000000000

# Optional: redirect the deployments/ directory (used by CI / ephemeral runs).
# DEPLOYMENT_PATH=

# Block explorer verification (0G ignores the key value, but the flag is required).
VERIFIER_KEY=00
